{
  "name": "hub",
  "publisher": "paradise",
  "version": "0.1.0",
  "displayName": "Paradise Extensions",
  "description": "Discover Paradise extensions, create your own, and package or install them without leaving the editor.",
  "license": "MIT",
  "engines": {
    "vscode": "^1.140.0"
  },
  "main": "./extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "paradise.hub.open",
        "title": "Paradise: Extension Hub"
      },
      {
        "command": "paradise.hub.create",
        "title": "Paradise: Create Extension"
      },
      {
        "command": "paradise.hub.package",
        "title": "Paradise: Package and Install Extension"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "paradise",
          "title": "Paradise",
          "icon": "media/mark.svg"
        }
      ]
    },
    "views": {
      "paradise": [
        {
          "id": "paradise.extensions",
          "name": "Paradise Extensions"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "paradise.extensions",
        "contents": "Extensions made for your editor.\n[Open Extension Hub](command:paradise.hub.open)\n[Create an extension](command:paradise.hub.create)\n[Browse Open VSX](command:workbench.view.extensions)"
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  }
}
