{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paradise Code",
  "version": "0.1.0",
  "identifier": "dev.paradise.code",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A local Code - OSS workbench in Tauri",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": [
      "resources/backend-launcher.mjs",
      "resources/backend/"
    ],
    "fileAssociations": [
      {
        "ext": [
          "txt",
          "md",
          "js",
          "ts",
          "tsx",
          "jsx",
          "json",
          "html",
          "css",
          "code-workspace"
        ],
        "role": "Editor",
        "name": "Source Code"
      }
    ]
  }
}
